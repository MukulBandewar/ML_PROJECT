<escape>{
  "name": "Python 3",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "Mukul Bandewar_TASK_1/app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip install -r 'Mukul Bandewar_TASK_1/requirements.txt' && pip install streamlit",
  "postAttachCommand": {
    "server": "streamlit run 'Mukul Bandewar_TASK_1/app.py' --server.address 0.0.0.0"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}</escape>
